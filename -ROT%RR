local function SwitchTab(index)
    for i, page in ipairs(Pages) do
        page.Visible = (i == index)
        if i == index then
            TabButtons[i].BackgroundColor3 = Color3.fromRGB(90, 60, 200)
            TabButtons[i].TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            TabButtons[i].BackgroundColor3 = Color3.fromRGB(35, 35, 48)
            TabButtons[i].TextColor3 = Color3.fromRGB(180, 180, 200)
        end
    end
end

for i, btn in ipairs(TabButtons) do
    btn.MouseButton1Click:Connect(function()
        SwitchTab(i)
    end)
end

local function AddChatMessage(text, isMe)
    local msg = Instance.new("TextLabel")
    msg.Size = UDim2.new(1, -16, 0, 0)
    msg.BackgroundTransparency = 1
    msg.Text = (isMe and "أنت : " or "مستخدم : ") .. text
    msg.TextColor3 = isMe and Color3.fromRGB(180, 150, 255) or Color3.fromRGB(200, 200, 220)
    msg.Font = Enum.Font.Gotham
    msg.TextSize = 13
    msg.TextWrapped = true
    msg.TextXAlignment = Enum.TextXAlignment.Left
    msg.Parent = ChatLog
    msg.Size = UDim2.new(1, -16, 0, msg.TextBounds.Y + 8)
    ChatLog.CanvasSize = UDim2.new(0, 0, 0, ChatList.AbsoluteContentSize.Y + 20)
    ChatLog.CanvasPosition = Vector2.new(0, ChatLog.CanvasSize.Y.Offset)
end

SendBtn.MouseButton1Click:Connect(function()
    local text = ChatInput.Text
    if text and text \~= "" then
        AddChatMessage(text, true)
        ChatInput.Text = ""
    end
end)

ChatInput.FocusLost:Connect(function(enter)
    if enter then
        local text = ChatInput.Text
        if text and text \~= "" then
            AddChatMessage(text, true)
            ChatInput.Text = ""
        end
    end
end)

local AIResponses = {
    ["مرحبا"] = "أهلاً وسهلاً ، كيف بقدر أساعدك ؟",
    ["هلا"] = "هلا فيك ، شو بتحتاج ؟",
    ["كيفك"] = "تمام الحمدلله ، وأنت ؟",
    ["شكرا"] = "العفو ، أي خدمة تانية ؟",
    ["rot"] = "أنا ROT ، سكربت شرعي وجميل",
    ["مساعدة"] = "اكتب أي سؤال وأنا برد عليك",
    ["باي"] = "مع السلامة ، استمتع باللعبة"
}

local function GetAIResponse(input)
    input = string.lower(input)
    for key, reply in pairs(AIResponses) do
        if string.find(input, key) then
            return reply
        end
    end
    return "ما فهمت سؤالك ، جرب تكتب بطريقة ثانية أو اكتب مساعدة"
end

local function AddAIMessage(text, isUser)
    local msg = Instance.new("TextLabel")
    msg.Size = UDim2.new(1, -16, 0, 0)
    msg.BackgroundTransparency = 1
    msg.Text = (isUser and "أنت : " or "ROT : ") .. text
    msg.TextColor3 = isUser and Color3.fromRGB(180, 150, 255) or Color3.fromRGB(120, 220, 180)
    msg.Font = Enum.Font.Gotham
    msg.TextSize = 13
    msg.TextWrapped = true
    msg.TextXAlignment = Enum.TextXAlignment.Left
    msg.Parent = AILog
    msg.Size = UDim2.new(1, -16, 0, msg.TextBounds.Y + 8)
    AILog.CanvasSize = UDim2.new(0, 0, 0, AIList.AbsoluteContentSize.Y + 20)
    AILog.CanvasPosition = Vector2.new(0, AILog.CanvasSize.Y.Offset)
end

AISend.MouseButton1Click:Connect(function()
    local text = AIInput.Text
    if text and text \~= "" then
        AddAIMessage(text, true)
        local reply = GetAIResponse(text)
        task.wait(0.4)
        AddAIMessage(reply, false)
